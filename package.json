{
  "name": "ayumi-draft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run bundle:api",
    "bundle:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/analyze.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "eval:real": "tsx eval/run.ts --real",
    "verify:ui": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
